# L&D Analytics Platform — environment template
#
# Copy to .env for local development:   cp .env.example .env
#
# NOTHING in this file is a real credential. Staging and production values come
# from the company secret store and are injected as environment variables at
# deploy time (BRD NFR-11). Never commit a populated .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# One of: dev | staging | production
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Superuser / owner — runs Alembic migrations only.
POSTGRES_USER=lnd
POSTGRES_PASSWORD=change-me-in-dev-only
POSTGRES_DB=lnd
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Least-privilege login role the API, worker and beat connect as. It is a member
# of the lnd_app group role created by migration 0001, which grants SELECT and
# INSERT on raw.* but never UPDATE or DELETE — this is how raw immutability is
# enforced with grants rather than convention.
APP_DB_USER=lnd_app_rw
APP_DB_PASSWORD=change-me-in-dev-only

# ---------------------------------------------------------------------------
# Redis — Celery broker and aggregate cache
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Signing key for the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=generate-a-real-one-with-secrets-token-urlsafe-48
SESSION_MAX_AGE_SECONDS=28800

# ---------------------------------------------------------------------------
# OIDC / company SSO (NFR-04 — no local passwords)
# ---------------------------------------------------------------------------
# Entra ID discovery URL looks like:
#   https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Must exactly match the redirect URI registered with the IdP.
OIDC_REDIRECT_URI=http://localhost:8080/v1/auth/callback

# Development only. Refused at startup unless ENVIRONMENT=dev. Lets you sign in
# as a fake user before IT has issued an app registration, so the rest of week 1
# is not blocked on it.
AUTH_DEV_BYPASS=true
AUTH_DEV_USER_EMAIL=ld.specialist@example.com
AUTH_DEV_USER_NAME=Dev Specialist

# ---------------------------------------------------------------------------
# CRM — Learning Program Dataset API
# ---------------------------------------------------------------------------
# Two read-only endpoints, both under {CRM_BASE_URL}/api/learning-integration:
#   /programs   — the training dataset: programs, sessions, attendance, surveys
#   /get_users  — the employee roster, which is the participation denominator
# See docs/LEARNING_PROGRAM_DATASET_API.md and docs/learning-integration-api.md
#
# The host only — no path, no trailing slash. A trailing /api is trimmed, since
# the endpoint path already begins with it.
CRM_BASE_URL=https://apicrm.theaddress.app

# Static shared secret, sent in the X-Learning-Key header. NOT a bearer token —
# a key placed in Authorization reads as missing and returns 401.
# The CRM team sets it their side as LEARNING_INTEGRATION_SERVICE_KEY.
CRM_SERVICE_KEY=

CRM_TIMEOUT_SECONDS=60
# Each entry carries a program's whole roster and every answer on it, so a big
# page is a big response. 10-25 is the documented comfortable size.
CRM_PER_PAGE=10
# The roster is the opposite shape: small rows, and a lot of them. 1,427 active
# employees at the programs page size would be 143 requests against a documented
# 120/minute limit, so the two endpoints get their own page sizes.
CRM_EMPLOYEE_PER_PAGE=200
# Which employees the roster pull asks for. `active` is the participation
# denominator — people who could attend. Blank fetches leavers too.
CRM_EMPLOYEE_STATUS=active
# The filter[...] key the CRM accepts for "changed since", if it accepts one at
# all. Empty means it does not, and the incremental sync fetches everything each
# pass — correct, just wasteful: an unchanged record re-lands as a no-op.
CRM_CHANGED_SINCE_FILTER=

# Save every source response verbatim as a contract fixture. Refused at startup
# in production — recorded payloads contain PII.
SOURCE_RECORD_FIXTURES=false

# ---------------------------------------------------------------------------
# Report delivery (week 9)
# ---------------------------------------------------------------------------
# Blank SMTP_HOST is the off switch, and it is a switch rather than an
# environment check on purpose: staging must be able to send to a mailbox
# somebody is watching, and production must be able to stop sending without a
# deploy while a relay is moved. Switched off, the monthly job still generates
# and still keeps the edition — it records "not sent" with the reason, which the
# console shows and the report_undelivered alert reports.
SMTP_HOST=
SMTP_PORT=587
SMTP_USERNAME=
SMTP_PASSWORD=
# STARTTLS upgrades a plain connection on 587; SSL wraps one from the first byte
# on 465. They are mutually exclusive and startup refuses both at once. Refused
# entirely in production if neither is set: the attachment carries employee names.
SMTP_STARTTLS=true
SMTP_SSL=false
SMTP_TIMEOUT_SECONDS=30

REPORT_FROM_ADDRESS=lnd-analytics@example.com
# Comma-separated. A list rather than a distribution alias, because a delivery
# nobody can enumerate is a delivery nobody can audit — and `delivered_to` on
# each edition stores the addresses as they were resolved at send time.
REPORT_RECIPIENTS=
# Attach the PDF beside the workbook. Both are kept as editions either way.

# How long a record may be excluded from figures before somebody is told rather
# than left to notice. Seven days: long enough that a fix authored the same
# afternoon never alerts, short enough that nothing sits out of the numbers for
# a whole reporting cycle unremarked.
ALERT_EXCLUSION_AGE_SECONDS=604800

# ---------------------------------------------------------------------------
# Container image tags (set by CI to the commit SHA; see "built once, promoted")
# ---------------------------------------------------------------------------
REGISTRY=ghcr.io/theaddresstech
IMAGE_TAG=dev
