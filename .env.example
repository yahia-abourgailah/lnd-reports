# L&D Analytics Platform — environment template
#
# Copy to .env for local development:   cp .env.example .env
#
# NOTHING in this file is a real credential. Staging and production values come
# from the company secret store and are injected as environment variables at
# deploy time (BRD NFR-11). Never commit a populated .env.

# ---------------------------------------------------------------------------
# Core
# ---------------------------------------------------------------------------
# One of: dev | staging | production
ENVIRONMENT=dev
LOG_LEVEL=INFO
API_BASE_URL=http://localhost:8080
WEB_BASE_URL=http://localhost:8080

# ---------------------------------------------------------------------------
# Database
# ---------------------------------------------------------------------------
# Superuser / owner — runs Alembic migrations only.
POSTGRES_USER=lnd
POSTGRES_PASSWORD=change-me-in-dev-only
POSTGRES_DB=lnd
POSTGRES_HOST=db
POSTGRES_PORT=5432

# Least-privilege login role the API, worker and beat connect as. It is a member
# of the lnd_app group role created by migration 0001, which grants SELECT and
# INSERT on raw.* but never UPDATE or DELETE — this is how raw immutability is
# enforced with grants rather than convention.
APP_DB_USER=lnd_app_rw
APP_DB_PASSWORD=change-me-in-dev-only

# ---------------------------------------------------------------------------
# Redis — Celery broker and aggregate cache
# ---------------------------------------------------------------------------
REDIS_URL=redis://redis:6379/0

# ---------------------------------------------------------------------------
# Session
# ---------------------------------------------------------------------------
# Signing key for the session cookie. Generate with:
#   python -c "import secrets; print(secrets.token_urlsafe(48))"
SESSION_SECRET=generate-a-real-one-with-secrets-token-urlsafe-48
SESSION_MAX_AGE_SECONDS=28800

# ---------------------------------------------------------------------------
# OIDC / company SSO (NFR-04 — no local passwords)
# ---------------------------------------------------------------------------
# Entra ID discovery URL looks like:
#   https://login.microsoftonline.com/<tenant-id>/v2.0/.well-known/openid-configuration
OIDC_DISCOVERY_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
# Must exactly match the redirect URI registered with the IdP.
OIDC_REDIRECT_URI=http://localhost:8080/v1/auth/callback

# Development only. Refused at startup unless ENVIRONMENT=dev. Lets you sign in
# as a fake user before IT has issued an app registration, so the rest of week 1
# is not blocked on it.
AUTH_DEV_BYPASS=true
AUTH_DEV_USER_EMAIL=ld.specialist@example.com
AUTH_DEV_USER_NAME=Dev Specialist

# ---------------------------------------------------------------------------
# CRM — Learning Program Dataset API
# ---------------------------------------------------------------------------
# One read-only endpoint: GET {CRM_BASE_URL}/api/learning-integration/programs
# See docs/LEARNING_PROGRAM_DATASET_API.md
#
# The host only — no path, no trailing slash. A trailing /api is trimmed, since
# the endpoint path already begins with it.
CRM_BASE_URL=https://apicrm.theaddress.app

# Static shared secret, sent in the X-Learning-Key header. NOT a bearer token —
# a key placed in Authorization reads as missing and returns 401.
# The CRM team sets it their side as LEARNING_INTEGRATION_SERVICE_KEY.
CRM_SERVICE_KEY=

CRM_TIMEOUT_SECONDS=60
# Each entry carries a program's whole roster and every answer on it, so a big
# page is a big response. 10-25 is the documented comfortable size.
CRM_PER_PAGE=10

# Save every source response verbatim as a contract fixture. Refused at startup
# in production — recorded payloads contain PII.
SOURCE_RECORD_FIXTURES=false

# ---------------------------------------------------------------------------
# Container image tags (set by CI to the commit SHA; see "built once, promoted")
# ---------------------------------------------------------------------------
REGISTRY=ghcr.io/theaddresstech
IMAGE_TAG=dev
